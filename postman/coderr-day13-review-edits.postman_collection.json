{
  "info": {
    "name": "Coderr Day 13 - Review Edit and Delete",
    "description": "Registers two fictional customers and deletes only the review created in this run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "customer_username",
      "value": ""
    },
    {
      "key": "customer_email",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "test_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register customer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/registration/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{customer_username}}\",\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"repeated_password\": \"{{test_password}}\",\n  \"type\": \"customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + '_' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('test_password', 'Local!' + pm.variables.replaceIn('{{$randomUUID}}'));",
              "pm.collectionVariables.set('customer_username', 'tag13_customer_' + suffix);",
              "pm.collectionVariables.set('customer_email', 'customer_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('customer_token', '');",
              "pm.collectionVariables.set('business_username', 'tag13_business_' + suffix);",
              "pm.collectionVariables.set('business_email', 'business_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('business_token', '');",
              "pm.collectionVariables.set('other_customer_username', 'tag13_other_customer_' + suffix);",
              "pm.collectionVariables.set('other_customer_email', 'other_customer_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('other_customer_token', '');",
              "pm.collectionVariables.set('other_business_username', 'tag13_other_business_' + suffix);",
              "pm.collectionVariables.set('other_business_email', 'other_business_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('other_business_token', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Registration fields', () => { pm.expect(data).to.have.all.keys('token','username','email','user_id'); });",
              "pm.test('Token and user ID', () => { pm.expect(data.token).to.be.a('string').and.not.empty; pm.expect(data.user_id).to.be.a('number').and.above(0); });",
              "pm.collectionVariables.set('customer_token', data.token);",
              "pm.collectionVariables.set('customer_id', data.user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register other customer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/registration/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{other_customer_username}}\",\n  \"email\": \"{{other_customer_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"repeated_password\": \"{{test_password}}\",\n  \"type\": \"customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Registration fields', () => { pm.expect(data).to.have.all.keys('token','username','email','user_id'); });",
              "pm.test('Token and user ID', () => { pm.expect(data.token).to.be.a('string').and.not.empty; pm.expect(data.user_id).to.be.a('number').and.above(0); });",
              "pm.collectionVariables.set('other_customer_token', data.token);",
              "pm.collectionVariables.set('other_customer_id', data.user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create review",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reviews/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": 14, \"rating\": 4, \"description\": \"Gute Zusammenarbeit beim Blumenladen-Projekt.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const review = pm.response.json();",
              "pm.test('Server assigned author', () => pm.expect(review.reviewer).to.eql(Number(pm.collectionVariables.get('customer_id'))));",
              "pm.test('Expected provider and rating', () => { pm.expect(review.business_user).to.eql(14); pm.expect(review.rating).to.eql(4); });",
              "pm.collectionVariables.set('review_id', review.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Author edits stars",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 5}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Stars changed and text preserved', () => {const row=pm.response.json(); pm.expect(row.rating).to.eql(5); pm.expect(row.description).to.eql('Gute Zusammenarbeit beim Blumenladen-Projekt.');});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject provider change",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": 26}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject six stars",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 6}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Other customer cannot edit",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{other_customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"rating\": 1}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Other customer cannot delete",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{other_customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Author deletes review",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('Empty response', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted review absent from list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reviews/?reviewer_id={{customer_id}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Empty list', () => pm.expect(pm.response.json()).to.eql([]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Repeat deletion returns 404",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/reviews/{{review_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
