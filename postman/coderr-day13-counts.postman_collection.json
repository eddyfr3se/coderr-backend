            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown - completed-order-count",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/completed-order-count/999999/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous - completed-order-count",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/completed-order-count/14/",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
