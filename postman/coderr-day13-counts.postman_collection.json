              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Exact count', () => pm.expect(pm.response.json()).to.eql({completed_order_count: 0}));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer - completed-order-count",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/completed-order-count/{{customer_id}}/",
        "header": [
          {
            "key": "Authorization",
