{
  "info": {
    "name": "Coderr Day 10 - Offer Pagination",
    "description": "Read-only pagination checks using the three retained Day 9 offers for business_id 24. Run with No Environment and without stored cookies. No accounts or offers are created.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "business_id",
      "value": "24"
    }
  ],
  "item": [
    {
      "name": "01 Retained offers and default page",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/offers/?creator_id={{business_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Three retained offers', () => { pm.expect(data.count).to.eql(3); pm.expect(data.results.map(o => o.title)).to.eql(['Logo Starter','Website Express','Website Komplett']); });",
              "pm.test('Pagination envelope and no links', () => { pm.expect(data).to.have.all.keys('count','next','previous','results'); pm.expect(data.next).to.eql(null); pm.expect(data.previous).to.eql(null); });",
              "['cheap','fast','slow'].forEach((name,index) => pm.collectionVariables.set(name + '_id', data.results[index].id));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 One item on first page",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/offers/?creator_id={{business_id}}&page_size=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('First offer and total', () => { pm.expect(data.count).to.eql(3); pm.expect(data.results.map(o => o.id)).to.eql([Number(pm.collectionVariables.get('cheap_id'))]); });",
              "pm.test('First page links', () => { pm.expect(data.previous).to.eql(null); pm.expect(data.next).to.include('page=2'); pm.expect(data.next).to.include('page_size=1'); });",
              "pm.collectionVariables.set('next_url', data.next);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Follow next link to middle page",
      "request": {
        "method": "GET",
        "url": "{{next_url}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Middle offer and total', () => { pm.expect(data.count).to.eql(3); pm.expect(data.results.map(o => o.id)).to.eql([Number(pm.collectionVariables.get('fast_id'))]); });",
              "pm.test('Middle page links', () => { pm.expect(data.next).to.include('page=3'); pm.expect(data.previous).to.be.a('string'); });",
              "pm.collectionVariables.set('next_url', data.next);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Follow next link to last page",
      "request": {
