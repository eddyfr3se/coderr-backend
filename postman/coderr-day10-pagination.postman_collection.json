            ]
          }
        }
      ]
    },
    {
      "name": "10 Combined filters before pagination",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/offers/?creator_id={{business_id}}&search=Logo&min_price=50&max_delivery_time=7&ordering=-min_price&page_size=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Two matches and highest price first', () => { pm.expect(data.count).to.eql(2); pm.expect(data.results.map(o => o.id)).to.eql([Number(pm.collectionVariables.get('fast_id'))]); });",
              "pm.test('Next link retains all parameters', () => { ['creator_id=' + pm.collectionVariables.get('business_id'),'search=Logo','min_price=50','max_delivery_time=7','ordering=-min_price','page_size=1','page=2'].forEach(p => pm.expect(data.next).to.include(p)); });",
              "pm.collectionVariables.set('filtered_next_url', data.next);"
            ]
          }
        }
      ]
    },
