    {
      "name": "08 Provider sets completed",
      "request": {
        "method": "PATCH",
        "url": "{{base_url}}/orders/{{order_id}}/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => { pm.response.to.have.status(200); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Expected status', () => { pm.expect(data.status).to.eql('completed'); });",
              "pm.test('Agreement fields unchanged', () => { const before=JSON.parse(pm.collectionVariables.get('order_snapshot')); pm.expect(Object.keys(data).sort()).to.eql(Object.keys(before).sort()); Object.keys(before).filter(k => !['status','updated_at'].includes(k)).forEach(k => pm.expect(data[k],k).to.eql(before[k])); });",
              "pm.test('Update timestamp', () => { pm.expect(Date.parse(data.updated_at)).to.be.at.least(Date.parse(JSON.parse(pm.collectionVariables.get('order_snapshot')).updated_at)); });"
            ]
          }
        }
      ]
    },
