    {
      "name": "05 Create test offer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/offers/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Statuspr\\u00fcfung Website\",\n  \"description\": \"Lokales Testangebot f\\u00fcr Bestellungen\",\n  \"image\": null,\n  \"details\": [\n    {\n      \"title\": \"basic Website\",\n      \"offer_type\": \"basic\",\n      \"price\": 180.5,\n      \"delivery_time_in_days\": 7,\n      \"features\": [\n        \"Startseite\"\n      ],\n      \"revisions\": 2\n    },\n    {\n      \"title\": \"standard Website\",\n      \"offer_type\": \"standard\",\n      \"price\": 280,\n      \"delivery_time_in_days\": 5,\n      \"features\": [\n        \"Startseite\"\n      ],\n      \"revisions\": 2\n    },\n    {\n      \"title\": \"premium Website\",\n      \"offer_type\": \"premium\",\n      \"price\": 380,\n      \"delivery_time_in_days\": 3,\n      \"features\": [\n        \"Startseite\"\n      ],\n      \"revisions\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Three packages created', () => { pm.expect(data.details).to.have.lengthOf(3); });",
              "pm.collectionVariables.set('offer_id', data.id);",
              "pm.collectionVariables.set('package_id', data.details.find(p => p.offer_type === 'basic').id);"
            ]
          }
        }
      ]
    },
