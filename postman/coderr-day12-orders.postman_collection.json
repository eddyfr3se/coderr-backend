  "item": [
    {
      "name": "01 Register customer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/registration/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{customer_username}}\",\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"repeated_password\": \"{{test_password}}\",\n  \"type\": \"customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + '_' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('test_password', 'Local!' + pm.variables.replaceIn('{{$randomUUID}}'));",
              "pm.collectionVariables.set('customer_username', 'tag12_customer_' + suffix);",
              "pm.collectionVariables.set('customer_email', 'customer_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('customer_token', '');",
              "pm.collectionVariables.set('business_username', 'tag12_business_' + suffix);",
              "pm.collectionVariables.set('business_email', 'business_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('business_token', '');",
              "pm.collectionVariables.set('other_customer_username', 'tag12_other_customer_' + suffix);",
              "pm.collectionVariables.set('other_customer_email', 'other_customer_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('other_customer_token', '');",
              "pm.collectionVariables.set('other_business_username', 'tag12_other_business_' + suffix);",
              "pm.collectionVariables.set('other_business_email', 'other_business_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('other_business_token', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Registration fields', () => { pm.expect(data).to.have.all.keys('token','username','email','user_id'); });",
              "pm.test('Token and user ID', () => { pm.expect(data.token).to.be.a('string').and.not.empty; pm.expect(data.user_id).to.be.a('number').and.above(0); });",
              "pm.collectionVariables.set('customer_token', data.token);",
              "pm.collectionVariables.set('customer_id', data.user_id);"
            ]
          }
        }
      ]
    },
