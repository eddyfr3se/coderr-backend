{
  "info": {
    "name": "Coderr Day 13 - Reviews",
    "description": "Registers a fictional Customer and leaves one local review for provider 14.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "customer_username",
      "value": ""
    },
    {
      "key": "customer_email",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "test_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register customer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/registration/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{customer_username}}\",\n  \"email\": \"{{customer_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"repeated_password\": \"{{test_password}}\",\n  \"type\": \"customer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + '_' + Math.floor(Math.random() * 100000);",
              "pm.collectionVariables.set('test_password', 'Local!' + pm.variables.replaceIn('{{$randomUUID}}'));",
              "pm.collectionVariables.set('customer_username', 'tag13_customer_' + suffix);",
              "pm.collectionVariables.set('customer_email', 'customer_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('customer_token', '');",
              "pm.collectionVariables.set('business_username', 'tag13_business_' + suffix);",
              "pm.collectionVariables.set('business_email', 'business_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('business_token', '');",
              "pm.collectionVariables.set('other_customer_username', 'tag13_other_customer_' + suffix);",
              "pm.collectionVariables.set('other_customer_email', 'other_customer_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('other_customer_token', '');",
              "pm.collectionVariables.set('other_business_username', 'tag13_other_business_' + suffix);",
              "pm.collectionVariables.set('other_business_email', 'other_business_' + suffix + '@coderr.example');",
              "pm.collectionVariables.set('other_business_token', '');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Registration fields', () => { pm.expect(data).to.have.all.keys('token','username','email','user_id'); });",
              "pm.test('Token and user ID', () => { pm.expect(data.token).to.be.a('string').and.not.empty; pm.expect(data.user_id).to.be.a('number').and.above(0); });",
              "pm.collectionVariables.set('customer_token', data.token);",
              "pm.collectionVariables.set('customer_id', data.user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reviews/",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous create",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reviews/",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": 14, \"rating\": 4, \"description\": \"Gute Zusammenarbeit beim Blumenladen-Projekt.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject six stars",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reviews/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": 14, \"rating\": 6, \"description\": \"Gute Zusammenarbeit beim Blumenladen-Projekt.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject customer target",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reviews/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": \"{{customer_id}}\", \"rating\": 4, \"description\": \"Gute Zusammenarbeit beim Blumenladen-Projekt.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create review",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reviews/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": 14, \"rating\": 4, \"description\": \"Gute Zusammenarbeit beim Blumenladen-Projekt.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const review = pm.response.json();",
              "pm.test('Server assigned author', () => pm.expect(review.reviewer).to.eql(Number(pm.collectionVariables.get('customer_id'))));",
              "pm.test('Expected provider and rating', () => { pm.expect(review.business_user).to.eql(14); pm.expect(review.rating).to.eql(4); });",
              "pm.collectionVariables.set('review_id', review.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject duplicate",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/reviews/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"business_user\": 14, \"rating\": 1, \"description\": \"Gute Zusammenarbeit beim Blumenladen-Projekt.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Read original by provider and author",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reviews/?business_user_id=14&reviewer_id={{customer_id}}&ordering=-rating",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Only original review remains', () => { const rows = pm.response.json(); pm.expect(rows).to.have.lengthOf(1); pm.expect(rows[0].id).to.eql(Number(pm.collectionVariables.get('review_id'))); pm.expect(rows[0].rating).to.eql(4); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid author filter",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/reviews/?reviewer_id=invalid",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
