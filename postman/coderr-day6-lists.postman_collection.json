    {
      "name": "07 Reject anonymous customer list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/profiles/customer/",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', function () { pm.response.to.have.status(401); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });"
            ]
          }
        }
      ]
