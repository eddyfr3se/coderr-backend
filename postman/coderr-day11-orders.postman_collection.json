    {
      "name": "07 Customer creates order",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/orders/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"offer_detail_id\": \"{{package_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => { pm.response.to.have.status(201); });",
              "pm.test('JSON response', () => { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Exact order response fields', () => { pm.expect(data).to.have.all.keys('id','customer_user','business_user','title','revisions','delivery_time_in_days','price','features','offer_type','status','created_at','updated_at'); });",
              "pm.test('Server assigned participants', () => { pm.expect(data.customer_user).to.eql(Number(pm.collectionVariables.get('customer_id'))); pm.expect(data.business_user).to.eql(Number(pm.collectionVariables.get('business_id'))); });",
              "pm.test('Original package values', () => { pm.expect(data.title).to.eql('basic Website'); pm.expect(data.price).to.eql(180.5); pm.expect(data.revisions).to.eql(2); pm.expect(data.delivery_time_in_days).to.eql(7); pm.expect(data.features).to.eql(['Startseite']); pm.expect(data.offer_type).to.eql('basic'); });",
              "pm.test('Initial status and timestamps', () => { pm.expect(data.status).to.eql('in_progress'); pm.expect(Number.isNaN(Date.parse(data.created_at))).to.eql(false); pm.expect(Number.isNaN(Date.parse(data.updated_at))).to.eql(false); });",
              "pm.collectionVariables.set('order_id', data.id);"
            ]
          }
        }
      ]
    },
