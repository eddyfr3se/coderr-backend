          "raw": "{\n  \"offer_detail_id\": \"{{package_id}}\",\n  \"customer_user\": \"{{other_customer_id}}\",\n  \"business_user\": \"{{other_business_id}}\",\n  \"price\": 1,\n  \"status\": \"completed\",\n  \"title\": \"Fake\",\n  \"features\": [\n    \"Fake\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
