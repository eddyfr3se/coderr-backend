        "url": "{{base_url}}/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{business_username}}\",\n  \"email\": \"{{business_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"repeated_password\": \"{{test_password}}\",\n  \"type\": \"business\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Exact response fields', function () { pm.expect(data).to.have.all.keys('token', 'username', 'email', 'user_id'); });",
              "pm.test('Token is nonempty text', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
              "pm.test('User ID is a positive number', function () { pm.expect(data.user_id).to.be.a('number').and.above(0); });",
              "pm.test('Expected username and email', function () { pm.expect(data.username).to.eql(pm.collectionVariables.get('business_username')); pm.expect(data.email).to.eql(pm.collectionVariables.get('business_email')); });",
              "pm.test('No password fields', function () { pm.expect(data).not.to.have.property('password'); pm.expect(data).not.to.have.property('repeated_password'); });",
              "pm.collectionVariables.set('business_token', data.token);",
              "pm.collectionVariables.set('business_id', data.user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Business creates offer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          }
        ],
        "url": "{{base_url}}/offers/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman Grafikdesign\",\n  \"image\": null,\n  \"description\": \"Lokales Testangebot\",\n  \"details\": [\n    {\n      \"title\": \"basic Design\",\n      \"revisions\": -1,\n      \"delivery_time_in_days\": 7,\n      \"price\": \"100.50\",\n      \"features\": [\n        \"Logo\"\n      ],\n      \"offer_type\": \"basic\"\n    },\n    {\n      \"title\": \"standard Design\",\n      \"revisions\": -1,\n      \"delivery_time_in_days\": 5,\n      \"price\": 200,\n      \"features\": [\n        \"Logo\"\n      ],\n      \"offer_type\": \"standard\"\n    },\n    {\n      \"title\": \"premium Design\",\n      \"revisions\": -1,\n      \"delivery_time_in_days\": 2,\n      \"price\": 200,\n      \"features\": [\n        \"Logo\"\n      ],\n      \"offer_type\": \"premium\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Exact offer fields', () => pm.expect(data).to.have.all.keys('id','title','image','description','details'));",
              "pm.test('Offer ID', () => pm.expect(data.id).to.be.a('number').above(0));",
              "pm.test('Three package types', () => { pm.expect(data.details).to.have.lengthOf(3); pm.expect(data.details.map(d => d.offer_type)).to.have.members(['basic','standard','premium']); });",
              "pm.test('Package fields and values', () => data.details.forEach(d => { pm.expect(d).to.have.all.keys('id','title','revisions','delivery_time_in_days','price','features','offer_type'); pm.expect(d.id).to.be.a('number').above(0); pm.expect(d.revisions).to.eql(-1); pm.expect(d.delivery_time_in_days).to.eql(d.offer_type === 'basic' ? 7 : d.offer_type === 'premium' ? 2 : 5); pm.expect(d.price).to.eql(d.offer_type === 'basic' ? 100.5 : 200); pm.expect(d.features).to.eql(['Logo']); }));",
              "pm.test('Optional image', () => pm.expect(data.image).to.eql(null));",
              "pm.collectionVariables.set('offer_id', data.id);",
              "pm.collectionVariables.set('package_id', data.details.find(d => d.offer_type === 'basic').id);",
              "pm.collectionVariables.set('original_packages', JSON.stringify(data.details));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Owner changes only basic price",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/offers/{{offer_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"details\": [\n    {\n      \"offer_type\": \"basic\",\n      \"price\": \"120.00\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Full update response', () => pm.expect(data).to.have.all.keys('id','title','image','description','details'));",
              "pm.test('Only basic price changed', () => { const expected = JSON.parse(pm.collectionVariables.get('original_packages')); expected.find(d => d.offer_type === 'basic').price = 120; pm.expect(data.details).to.eql(expected); });",
              "pm.test('Offer fields preserved', () => { pm.expect(data.title).to.eql('Postman Grafikdesign'); pm.expect(data.description).to.eql('Lokales Testangebot'); pm.expect(data.image).to.eql(null); });"
            ]
          }
        }
      ]
    },
