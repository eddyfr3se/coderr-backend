    {
      "name": "10 Read offer after rejected edits",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          }
        ],
        "url": "{{base_url}}/offers/{{offer_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Offer unchanged by rejected edits', () => { pm.expect(data.title).to.eql('Postman Grafikdesign'); pm.expect(data.min_price).to.eql(120); pm.expect(data.min_delivery_time).to.eql(2); });",
              "pm.test('Package IDs preserved', () => { const original = JSON.parse(pm.collectionVariables.get('original_packages')); pm.expect(data.details.map(d => d.id)).to.have.members(original.map(d => d.id)); });"
            ]
          }
        }
