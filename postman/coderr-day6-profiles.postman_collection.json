              "const data = pm.response.json();",
              "pm.test('Exact profile fields', function () { pm.expect(data).to.have.all.keys('user', 'username', 'first_name', 'last_name', 'file', 'location', 'tel', 'description', 'working_hours', 'type', 'email', 'created_at'); });",
              "pm.test('Correct profile owner', function () { pm.expect(data.user).to.eql(Number(pm.collectionVariables.get('customer_id'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Update own profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/profile/{{customer_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\"first_name\": \"Mara\", \"location\": \"Berlin\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Exact profile fields', function () { pm.expect(data).to.have.all.keys('user', 'username', 'first_name', 'last_name', 'file', 'location', 'tel', 'description', 'working_hours', 'type', 'email', 'created_at'); });",
              "pm.test('Changes returned and omitted fields preserved', function () { pm.expect(data.first_name).to.eql('Mara'); pm.expect(data.location).to.eql('Berlin'); pm.expect(data.last_name).to.eql(''); pm.expect(data.type).to.eql('customer'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Verify changes were saved",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ],
        "url": "{{base_url}}/profile/{{customer_id}}/"
      },
      "event": [
        {
          "listen": "test",
