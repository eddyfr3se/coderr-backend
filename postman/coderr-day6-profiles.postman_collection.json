        "url": "{{base_url}}/registration/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{business_username}}\",\n  \"email\": \"{{business_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"repeated_password\": \"{{test_password}}\",\n  \"type\": \"business\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Exact response fields', function () { pm.expect(data).to.have.all.keys('token', 'username', 'email', 'user_id'); });",
              "pm.test('Token is nonempty text', function () { pm.expect(data.token).to.be.a('string').and.not.empty; });",
              "pm.test('User ID is a positive number', function () { pm.expect(data.user_id).to.be.a('number').and.above(0); });",
              "pm.test('Expected username and email', function () { pm.expect(data.username).to.eql(pm.collectionVariables.get('business_username')); pm.expect(data.email).to.eql(pm.collectionVariables.get('business_email')); });",
              "pm.test('No password fields', function () { pm.expect(data).not.to.have.property('password'); pm.expect(data).not.to.have.property('repeated_password'); });",
              "pm.collectionVariables.set('business_token', data.token);",
              "pm.collectionVariables.set('business_id', data.user_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Read own profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{customer_token}}"
          }
        ],
        "url": "{{base_url}}/profile/{{customer_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('JSON response', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Exact profile fields', function () { pm.expect(data).to.have.all.keys('user', 'username', 'first_name', 'last_name', 'file', 'location', 'tel', 'description', 'working_hours', 'type', 'email', 'created_at'); });",
              "pm.test('Correct profile owner', function () { pm.expect(data.user).to.eql(Number(pm.collectionVariables.get('customer_id'))); });",
              "pm.test('Optional text starts empty', function () { ['first_name','last_name','location','tel','description','working_hours'].forEach(function (field) { pm.expect(data[field]).to.eql(''); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Read another user profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          }
        ],
        "url": "{{base_url}}/profile/{{customer_id}}/"
      },
      "event": [
        {
          "listen": "test",
