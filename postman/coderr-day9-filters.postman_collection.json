    {
      "name": "06 Public creator list",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/offers/?creator_id={{business_id}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Expected offer IDs', () => pm.expect(data.results.map(d => d.id)).to.have.members([Number(pm.collectionVariables.get('cheap_id')),Number(pm.collectionVariables.get('fast_id')),Number(pm.collectionVariables.get('slow_id'))]));",
              "pm.test('Paginated response', () => { pm.expect(data).to.have.all.keys('count','next','previous','results'); pm.expect(data.count).to.eql(3); });",
              "pm.test('Only selected provider and public fields', () => data.results.forEach(d => { pm.expect(d.user).to.eql(Number(pm.collectionVariables.get('business_id'))); pm.expect(d.user_details).to.have.all.keys('first_name','last_name','username'); pm.expect(d.user_details.username).to.eql(pm.collectionVariables.get('business_username')); }));"
            ]
          }
        }
      ]
    },
