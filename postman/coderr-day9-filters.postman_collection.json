    {
      "name": "03 Create cheap offer",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/offers/",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{business_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Logo Starter\",\n  \"description\": \"Design\",\n  \"image\": null,\n  \"details\": [\n    {\n      \"title\": \"basic\",\n      \"offer_type\": \"basic\",\n      \"price\": 50,\n      \"delivery_time_in_days\": 7,\n      \"features\": [\n        \"Design\"\n      ],\n      \"revisions\": 2\n    },\n    {\n      \"title\": \"standard\",\n      \"offer_type\": \"standard\",\n      \"price\": 100,\n      \"delivery_time_in_days\": 8,\n      \"features\": [\n        \"Design\"\n      ],\n      \"revisions\": 2\n    },\n    {\n      \"title\": \"premium\",\n      \"offer_type\": \"premium\",\n      \"price\": 150,\n      \"delivery_time_in_days\": 9,\n      \"features\": [\n        \"Design\"\n      ],\n      \"revisions\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "const data = pm.response.json();",
              "pm.test('Three packages created', () => pm.expect(data.details).to.have.lengthOf(3));",
              "pm.collectionVariables.set('cheap_id', data.id);"
            ]
          }
        }
      ]
    },
